<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd service template for a RIG persistent worker.

  Install (one per host; replace NODE_ID):
    cp templates/launchd-worker-plist.template \
       ~/Library/LaunchAgents/com.rig.<area>-worker.<NODE_ID>.plist
    sed -i '' "s|__NODE_ID__|<NODE_ID>|g" \
       ~/Library/LaunchAgents/com.rig.<area>-worker.<NODE_ID>.plist
    sed -i '' "s|__AREA__|<area>|g" \
       ~/Library/LaunchAgents/com.rig.<area>-worker.<NODE_ID>.plist
    sed -i '' "s|__RUNTIME_DIR__|/absolute/path/to/runtime|" \
       ~/Library/LaunchAgents/com.rig.<area>-worker.<NODE_ID>.plist
    launchctl load -w ~/Library/LaunchAgents/com.rig.<area>-worker.<NODE_ID>.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rig.__AREA__-worker.__NODE_ID__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__RUNTIME_DIR__/.venv/bin/<entrypoint></string>
        <string>worker</string>
        <string>--node-id</string>
        <string>__NODE_ID__</string>
        <string>--concurrency</string>
        <integer>2</integer>
    </array>

    <key>WorkingDirectory</key>
    <string>__RUNTIME_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__RUNTIME_DIR__/.venv/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>FOUNDER_RUNTIME_DB</key>
        <string>__RUNTIME_DIR__/state.db</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash; throttle so we don't tight-loop a broken worker. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>$HOME/.rig/__AREA__/logs/worker.__NODE_ID__.out.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/.rig/__AREA__/logs/worker.__NODE_ID__.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>